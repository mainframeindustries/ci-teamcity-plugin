<?xml version="1.0" encoding="UTF-8"?>
<!--
  TeamCity Debug Logging Configuration for Datadog CI Integration Plugin
  
  By default, the plugin logs at INFO level to TeamCity's main server log (teamcity-server.log).
  
  This configuration enables DEBUG-level logging and redirects all plugin logs to a separate
  dedicated log file for easier troubleshooting and monitoring.
  
  Usage:
  1. Go to Administration > Diagnostics > Logging Presets tab
     (https://teamcity.foo.bar/admin/admin.html?item=diagnostics&tab=log4j)
  2. Upload this file using the upload form on that page
  3. Select this file from the "Logging Presets" dropdown to activate it
  4. Plugin logs will appear under Administration > Diagnostics > Server Logs tab
     as "teamcity-datadog-ci.log"
-->
<Configuration status="INFO">
  <Appenders>
    <DelegateAppender>
      <!-- Dedicated log file for Datadog CI Integration plugin -->
      <RollingFile name="DATADOG_CI.LOG" 
                   fileName="${sys:teamcity_logs}/teamcity-datadog-ci.log" 
                   filePattern="${sys:teamcity_logs}/teamcity-datadog-ci.log.%i" 
                   append="true" 
                   createOnDemand="true">
        <PatternLayout pattern="[%d] %6p [%30.30t] - %30.30c - %m%n%ex" charset="UTF-8" />
        <SizeBasedTriggeringPolicy size="10 MB" />
        <!-- Keep up to 10 rotated log files -->
        <DefaultRolloverStrategy max="10" fileIndex="min" />
      </RollingFile>
    </DelegateAppender>
  </Appenders>
  
  <Loggers>
    <!-- Logger for all Datadog plugin classes -->
    <Logger name="jetbrains.buildServer.com.datadog.teamcity.plugin" 
            level="DEBUG" 
            additivity="false">
      <AppenderRef ref="DATADOG_CI.LOG" />
    </Logger>
  </Loggers>
</Configuration>
